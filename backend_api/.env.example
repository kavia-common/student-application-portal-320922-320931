# Security (required)
JWT_SECRET=change-me

# Optional
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440

# CORS (comma-separated list)
CORS_ALLOW_ORIGINS=*

# Database: prefer POSTGRES_URL; otherwise provide individual vars.
# These names must match the database container's exported env vars.
POSTGRES_URL=postgresql+psycopg2://user:pass@host:port/dbname
POSTGRES_HOST=localhost
POSTGRES_PORT=5001
POSTGRES_USER=appuser
POSTGRES_PASSWORD=...
POSTGRES_DB=myapp
